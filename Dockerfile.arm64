# Plugin por arquitetura ARM64 (aarch64)
#
# Abordagem adotada (Opcao A - Emulacao via Box86):
# O engine HLDS/ReHLDS e todos os plugins (Metamod-R, AMX Mod X, ReAPI,
# ReUnion, YaPB) sao binarios x86 (32 bits). Numa maquina ARM64 eles nao
# rodam nativamente, entao subimos o emulador Box86 (x86 -> ARM) e
# executamos TODOS eles dentro do mesmo processo emulado.
#
# - O container base e nativo aarch64 (debian bookworm).
# - Box86 e compilado para aarch64 a partir do codigo-fonte.
# - Multiarch:
#     * armhf = bibliotecas ARM32 "nativas" que o Box86 embrulha (libc, libstdc++).
#     * i386  = bibliotecas x86 que o Box86 NAO embrulha e carrega emuladas
#               (ex.: libcurl, libssl, libtinfo, zlib - necessarias p/ o steamcmd).
# - steamcmd e executado sob Box86 para baixar a base HLDS (mesmo fluxo do x86).
# - Os binarios x86 de ReHLDS/Metamod/ReUnion/YaPB sao copiados e executados
#   emulados por Box86; mapas, modelos e sons da pasta cstrike/ sao independentes
#   de arquitetura e funcionam igual.

FROM debian:bookworm-slim

# 0. Multiarch: habilita armhf (libs ARM32 nativas p/ Box86) e i386 (libs x86
#    emuladas). O comando dpkg aceita UMA arquitetura por chamada.
RUN dpkg --add-architecture armhf && \
    dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y --no-install-recommends \
        # Bibliotecas ARM32 nativas: usadas pelo Box86 ao embrulhar libc/libstdc++
        libc6:armhf libstdc++6:armhf libgcc-s1:armhf \
        # Bibliotecas x86 (i386): carregadas EMULADAS para libs que o Box86 nao embrulha
        libc6:i386 libstdc++6:i386 libgcc-s1:i386 zlib1g:i386 \
        # Dependencias do steamcmd (binario x86) executado sob Box86
        libcurl4:i386 libssl3:i386 libtinfo6:i386 \
        # Ferramentas
        unzip tar curl xz-utils ca-certificates \
        # Compilacao do Box86 + Qtoolchain cruzar armhf
        git cmake make python3 crossbuild-essential-armhf qemu-user-static \
    && rm -rf /var/lib/apt/lists/*

# 1. Box86: emulador userland x86 -> ARM, compilado para aarch64.
#    -DARM64=1 usa o cross-compilador arm-linux-gnueabihf-gcc (32-bit ARM).
#    CMAKE_CROSSCOMPILING_EMULATOR garante que o teste do CMake rode via
#    qemu-arm, tornando o build portavel para qualquer kernel arm64
#    (inclusive kernels de 16K pages, ex.: Raspberry Pi 5).
ENV BOX86_VERSION=0.3.8
RUN mkdir -p /opt/box86/src && \
    curl -fsSL -o /tmp/box86.tar.gz \
        https://github.com/ptitSeb/box86/archive/refs/tags/v${BOX86_VERSION}.tar.gz && \
    tar xzf /tmp/box86.tar.gz -C /opt/box86/src --strip-components=1 && \
    mkdir -p /opt/box86/src/build && cd /opt/box86/src/build && \
    cmake .. -DARM64=1 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DNOGIT=1 \
        -DCMAKE_CROSSCOMPILING_EMULATOR=/usr/bin/qemu-arm-static && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /opt/box86/src /tmp/box86.tar.gz

# 2. Variaveis de ambiente
#    LD_LIBRARY_PATH: loader nativo (SteamAPI fix, igual ao x86).
#    BOX86_LD_LIBRARY_PATH: onde o Box86 procura libs x86 (i386 + steamcmd/HLDS).
ENV LD_LIBRARY_PATH=/opt/steam/linux32
ENV BOX86_LD_LIBRARY_PATH=/usr/lib/i386-linux-gnu:/opt/steam/linux32

# 3. Usuario e grupos (mesmo uid do projeto x86)
RUN groupadd -r steam && useradd -r -u 1000 -g steam -m -d /opt/steam steam

# 4. Diretorios e permissoes
RUN mkdir -p /opt/steam/hlds /opt/dependencies && \
    chown -R steam:steam /opt/steam /opt/dependencies

USER steam
WORKDIR /opt/steam

# 5. Dependencias locais
COPY --chown=steam:steam dependencies /opt/dependencies
RUN mv /opt/dependencies/lib/hlds.install /opt/steam

# 6. SteamCMD + base HLDS (motor base) - executado sob Box86
RUN tar xzf /opt/dependencies/steamcmd_linux.tar.gz && \
    box86 ./linux32/steamcmd +runscript hlds.install && \
    rm steamcmd.sh

# 7. ReHLDS (binarios do servidor, x86 - emulados por Box86)
RUN unzip -o /opt/dependencies/rehlds-bin-3.14.0.857.zip -d /opt/steam/hlds && \
    unzip -o -j /opt/dependencies/rehlds-bin-3.14.0.857.zip "bin/linux32/*" -d /opt/steam/hlds && \
    unzip -o -j /opt/dependencies/rehlds-bin-3.14.0.857.zip "bin/linux32/valve/*" -d /opt/steam/hlds && \
    rm /opt/dependencies/rehlds-bin-3.14.0.857.zip

# 8. Steam SDK fix
RUN mkdir -p ~/.steam && ln -s /opt/steam/linux32 ~/.steam/sdk32

# 9. Metamod-R (x86 - emulado)
RUN mkdir -p /opt/steam/hlds/cstrike/addons/metamod && \
    unzip -o -j /opt/dependencies/metamod-bin-1.3.0.149.zip \
        "addons/metamod/metamod*" \
        -d /opt/steam/hlds/cstrike/addons/metamod && \
    rm /opt/dependencies/metamod-bin-1.3.0.149.zip

# 10. YaPB (bots, x86 - emulado) - dados já inclusos na pasta cstrike/ do repositorio
#     (a pasta addons/yapb com o yapb.so é sobreposta via volume em /opt/steam/hlds/cstrike)

# 11. Configuracoes finais
WORKDIR /opt/steam/hlds
RUN chmod +x hlds_run hlds_linux && echo 10 > steam_appid.txt

# 12. Entrypoint: executa o hlds_linux (x86) sob o Box86
COPY --chown=steam:steam arm64/entrypoint.sh /opt/steam/entrypoint.sh
RUN chmod +x /opt/steam/entrypoint.sh

ENTRYPOINT ["/opt/steam/entrypoint.sh"]
CMD ["+map", "de_dust2", "+maxplayers", "16"]